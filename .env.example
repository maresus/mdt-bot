# ══════════════════════════════════════════════
#  MDT&T — Environment Variables
#  Kopiraj v .env in izpolni vrednosti
# ══════════════════════════════════════════════

# ── OpenAI / LLM ──────────────────────────────
OPENAI_API_KEY=sk-...

# ── Clinic ID (ne spreminjaj) ─────────────────
CLINIC_ID=mdt

# ── PostgreSQL (Railway ga nastavi samodejno) ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Email (SMTP ali Resend) ───────────────────
# Opcija A: Resend (priporočeno za Railway)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@mdt.si

# Opcija B: SMTP (Gmail ali drug SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=mr@mdt.si
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=mr@mdt.si
# SMTP_FROM_NAME=MDT&T
# SMTP_SSL=false

# Admin email — sem prihajajo nova naročila
ADMIN_EMAIL=mr@mdt.si

# Email prefix za zadeve (opcijsko)
# SUBJECT_PREFIX=[MDT&T]

# ── SMS — Twilio (opcijsko) ───────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+386...

# ── IMAP — za branje odgovorov pacientov ──────
# IMAP_HOST=imap.gmail.com
# IMAP_USER=mr@mdt.si
# IMAP_PASSWORD=your_app_password
# IMAP_PORT=993
# IMAP_FOLDER=INBOX

# ── Admin dostop (opcijsko) ───────────────────
# ADMIN_TOKEN=some_secret_token
